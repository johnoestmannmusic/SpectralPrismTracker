# The project compiles with TypeScript 7, but typescript-eslint's parser
# hard-errors on TS >= 7 until it gains support (typescript-eslint#10940).
# `typescript6` (an npm alias for typescript@6) is installed alongside TS 7 and
# eslint.config.mjs redirects `require("typescript")` to it for linting only.
legacy-peer-deps=true
