{
  "name": "lantern-music-player",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal (TUI) Lantern Music Player — tracker, sampler and spectral synthesis.",
  "license": "MIT",
  "bin": {
    "lantern": "dist/tui/main.mjs",
    "lantern-run": "dist/tui/run-script.mjs"
  },
  "scripts": {
    "build:tui": "node scripts/build-tui.mjs",
    "dev:tui": "node scripts/build-tui.mjs && node dist/tui/main.mjs",
    "start:tui": "node dist/tui/main.mjs",
    "run:script": "node dist/tui/run-script.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run typecheck && npm run test && npm run audit:deps && npm run build:tui",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "build:prism-wasm": "node scripts/build-prism-wasm.mjs",
    "vendor:prism-dsp": "node scripts/vendor-prism-dsp.mjs"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "node-web-audio-api": "^2.2.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
